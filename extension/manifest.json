{
  "manifest_version": 3,
  "name": "클로이영어 — 클래스카드 연동",
  "version": "1.0",
  "description": "원장님 크롬의 클래스카드 로그인으로 플래너를 읽어 클로이영어 앱에 보냅니다. 비밀번호는 저장하지 않습니다.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://www.classcard.net/*",
    "https://chloe-english.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "클로이영어 클래스카드 연동" }
}
